# Example credentials file — copy to .env and fill in (never commit .env)
#   cp .env.example .env
#   set -a && source .env && set +a
#   ./scripts/collect-aws-state.sh

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # only for temporary / assumed-role creds
AWS_REGION=eu-central-1

# Optional overrides
# STATE_BUCKET=my-org-tfstate
# LOCK_TABLE=terraform-state-lock
# SERVICES=vpc,subnet,sg,ec2,s3
